---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import ProductGrid from '../components/ProductGrid.astro';
import AboutMe from '../components/AboutMe.astro';
import ContactForm from '../components/ContactForm.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/Footer.astro';
import { supabase } from '../lib/supabase';
import type { Producto } from '../types/producto';

const { data, error } = await supabase
  .from('productos')
  .select('*');
  // Si 'data' es null o hay un error, asignamos un array vacío []
const productos: Producto[] = (data || []) as Producto[];
---

<Layout 
  title="Catálogo Oficial | Moños, Vinchas y Hebillas Artesanales"
  description="Descubrí el catálogo de CV Accesorios. Moños, vinchas, hebillas y accesorios para el pelo hechos a mano en Argentina con un estilo elegante y femenino."
>
  <Header />
  
  <main id="contenido-principal" class="flex-grow">
    <Hero />
    <HeroCarousel productos={productos} />
    <ProductGrid 
      productos = {productos} 
      titulo="Catálogo Completo"
      text="Nuestro diseño único para cada estilo, tendencia, ocasión que estás buscando y más." 
    />
    <AboutMe />
    <ContactForm />
  </main>
  <WhatsAppButton />
  <Footer />
</Layout>