---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import ContactForm from '../../components/ContactForm.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import Footer from '../../components/Footer.astro';
import { supabase } from '../../lib/supabase';
import type { Producto } from '../../types/producto';

export async function getStaticPaths() {
  const { data } = await supabase.from('productos').select('*');
  const productos: Producto[] = (data || []) as Producto[];

  const subcategoriasInfo: Record<string, { nombre: string; descripcion: string }> = {
    'infantiles': {
      nombre: 'Moños Infantiles',
      descripcion: 'Diseños tiernos y seguros creados especialmente para las más pequeñas.'
    },
    'bordados': {
      nombre: 'Moños Bordados',
      descripcion: 'Moños con detalles bordados a mano, perfectos para un look elegante.'
    },
    'bordados-con-lazo': {
      nombre: 'Moños Bordados con Lazo',
      descripcion: 'Moños que combinan bordados delicados con la elegancia de un lazo.'
    },
    'navidenos': {
      nombre: 'Moños Navideños',
      descripcion: 'Diseños festivos y alegres para celebrar la temporada navideña con estilo.'
    },
    'monos-de-comunion': {
      nombre: 'Moños de Comunión',
      descripcion: 'Elegantes moños diseñados para complementar los atuendos de comunión.'
    },
    'lisos': {
      nombre: 'Moños Lisos',
      descripcion: 'Moños de colores sólidos, perfectos para cualquier ocasión.'
    },
    'full-brillo': {
      nombre: 'Moños Full Brillo',
      descripcion: 'Moños que brillan con estilo, ideales para destacar en cualquier evento.'
    },
    'de-tela': {
      nombre: 'Vinchas de Tela',
      descripcion: 'Vinchas confeccionadas con telas de alta calidad para un acabado perfecto.'
    },
    'vincha-escolar': {
      nombre: 'Vinchas Escolares',
      descripcion: 'Vinchas resistentes y cómodas, ideales para el uso diario en la escuela.'
    },
    'personalizadas': {
      nombre: 'Vinchas Personalizadas',
      descripcion: 'Vinchas que puedes personalizar con tu estilo y preferencias únicas.'
    },
    'vinchas-de-comunion': {
      nombre: 'Vinchas de Comunión',
      descripcion: 'Vinchas elegantes y delicadas, perfectas para complementar los atuendos de comunión.'
    },
    'scrunchies-escolares': {
      nombre: 'Scrunchies Escolares',
      descripcion: 'Scrunchies resistentes y cómodos, ideales para el uso diario en la escuela.'
    },
    'con-lazo': {
      nombre: 'Scrunchies con Lazo',
      descripcion: 'Scrunchies que combinan la suavidad de la tela con la elegancia de un lazo.'
    },
    'velvet': {
      nombre: 'Scrunchies Velvet',
      descripcion: 'Scrunchies Velvet, perfectas para un look elegante y cómodo.'
    },
    'saten': {
      nombre: 'Scrunchies de Satén',
      descripcion: 'Scrunchies de satén, suaves y elegantes, ideales para cualquier ocasión.'
    },
  };

  const categoriasValidas = ['monos', 'vinchas', 'hebillas', 'scrunchies', 'llaveros'];
  const paths = [];

  for (const cat of categoriasValidas) {
    const productosDeCat = productos.filter((p) => p.categoria === cat);
    // Obtenemos todas las subcategorías únicas presentes en la BD para esta categoría
    const subcats = [...new Set(productosDeCat.map((p) => p.subcategoria).filter(Boolean))];

    for (const sub of subcats) {
      if (!sub) continue;
      const info = subcategoriasInfo[sub] || {
        nombre: `${sub.replace('-', ' ')}`,
        descripcion: `Explorá nuestra selección de ${sub.replace('-', ' ')}.`
      };

      paths.push({
        params: { categoria: cat, subcategoria: sub },
        props: {
          nombreCategoria: info.nombre,
          descripcionCategoria: info.descripcion,
          productosFiltrados: productosDeCat.filter((p) => p.subcategoria === sub)
        }
      });
    }
  }

  return paths;
}

const { nombreCategoria, descripcionCategoria, productosFiltrados } = Astro.props;
---

<Layout 
  title={`${nombreCategoria} | CV Accesorios`}
  description={descripcionCategoria}
>
  <Header />

  <main id="contenido-principal" class="flex-grow">
    <Hero 
      title={nombreCategoria}
      subtitle={descripcionCategoria}
    />
    <ProductGrid 
      productos={productosFiltrados} 
      titulo={`Categoría: ${nombreCategoria}`} 
    />
    <ContactForm />
  </main>
  <WhatsAppButton />
  <Footer />
</Layout>