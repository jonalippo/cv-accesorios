---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProductGrid from '../components/ProductGrid.astro';
import AboutMe from '../components/AboutMe.astro';
import ContactForm from '../components/ContactForm.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Footer from '../components/Footer.astro';
import { supabase } from '../lib/supabase';
import type { Producto } from '../types/producto';

// Define las rutas estáticas válidas en tiempo de build consultando Supabase
export async function getStaticPaths() {
  // 1. Traemos todos los productos desde la base de datos
  const { data, error } = await supabase
    .from('productos')
    .select('*');

  const productos: Producto[] = (data || []) as Producto[];
  const categoriasValidas = [
    { 
      slug: 'monos', 
      nombre: 'Moños Artesanales', 
      descripcion: 'Explorá nuestra colección exclusiva de moños confeccionados a mano en telas seleccionadas.' 
    },
    { 
      slug: 'vinchas', 
      nombre: 'Vinchas Elegantes', 
      descripcion: 'Descubrí nuestras vinchas acolchadas, trenzadas y con perlas diseñadas para un uso cómodo y chic.' 
    },
    { 
      slug: 'hebillas', 
      nombre: 'Hebillas y Clips', 
      descripcion: 'Detalles delicados para sujetar tu pelo con elegancia y firmeza en cualquier ocasión.' 
    },
    { 
      slug: 'scrunchies', 
      nombre: 'Scrunchies', 
      descripcion: 'Colección de scrunchies en telas suaves y colores vibrantes para complementar tu estilo.' 
    }
  ];

  // 3. Mapeamos las rutas filtrando los productos de Supabase
  return categoriasValidas.map((cat) => ({
    params: { categoria: cat.slug },
    props: { 
      nombreCategoria: cat.nombre,
      descripcionCategoria: cat.descripcion,
      productosFiltrados: productos.filter((p) => p.categoria === cat.slug)
    }
  }));
}

const { nombreCategoria, descripcionCategoria, productosFiltrados } = Astro.props;
---

<Layout 
  title={`${nombreCategoria} | CV Accesorios`}
  description={descripcionCategoria}
>
  <Header />

  <main id="contenido-principal" class="flex-grow">
    <Hero 
      title={nombreCategoria}
      subtitle={descripcionCategoria}
    />
    <ProductGrid 
      productos={productosFiltrados} 
      titulo={`Colección: ${nombreCategoria}`} 
    />
    <AboutMe />
    <ContactForm />
  </main>
  <WhatsAppButton />
  <Footer />
</Layout>