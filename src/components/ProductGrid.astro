---
import ProductCard from './ProductCard.astro';
import type { Producto } from '../types/producto';

interface Props {
  productos: Producto[];
  titulo?: string;
  text?: string;
}

const { productos, titulo = "Productos", text } = Astro.props;
const productosOrdenados = [...productos].sort((a, b) => Number(b.id) - Number(a.id)) .slice(0, 12);
---

<section id="catalogo" class="py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
  <div class="text-center mb-12 space-y-6">
    <h2 class="font-serif text-3xl sm:text-6xl font-semibold text-texto">
      {titulo}
    </h2>
    <p class="text-base sm:text-lg text-texto/80 font-normal">{text}</p>
    <div class="w-16 h-0.5 bg-rosa-oscuro mx-auto rounded-full"></div>
  </div>

  {productos.length > 0 ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 lg:gap-8">
      {productosOrdenados.map((prod) => (
        <ProductCard
          id={prod.id}
          nombre={prod.nombre}
          descripcion={prod.descripcion}
          categoria={prod.categoria}
          imagen={prod.imagen}
        />
      ))}
    </div>
  ) : (
    <div class="text-center py-12 bg-rosa/20 rounded-2xl max-w-md mx-auto">
      <p class="text-texto/80 font-medium">No se encontraron productos en esta categoría.</p>
    </div>
  )}
</section>

<script>
  function setupProductGrid() {
    // 1. IntersectionObserver para animación fade-in al scrollear
    const cards = document.querySelectorAll('.product-card');

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry, index) => {
          if (entry.isIntersecting) {
            // Aplicar un pequeño delay progresivo entre elementos
            setTimeout(() => {
              entry.target.classList.add('reveal');
            }, (index % 4) * 100);
            obs.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      });

      cards.forEach(card => observer.observe(card));
    } else {
      // Fallback si el navegador no soporta IntersectionObserver
      cards.forEach(card => card.classList.add('reveal'));
    }

    // 2. Manejo de fallback para links de Instagram Direct
    const igButtons = document.querySelectorAll('.btn-consultar-ig');
    igButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        const anchor = button as HTMLAnchorElement;
        const fallback = anchor.getAttribute('data-fallback');
        
        // Si no abre la app/link en 1.5s, redirigir al perfil general de Instagram
        setTimeout(() => {
          if (document.hidden || !fallback) return;
          window.location.href = fallback;
        }, 1500);
      });
    });
  }

  setupProductGrid();
  document.addEventListener('astro:page-load', setupProductGrid);
</script>