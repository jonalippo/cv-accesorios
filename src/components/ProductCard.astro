---
interface Props {
  id: string;
  nombre: string;
  descripcion: string;
  categoria: string;
  imagen: string;
  destacado?: boolean;
}

const { nombre, descripcion,imagen } = Astro.props;
const igDirectUrl = "https://ig.me/m/c.v.accesorios";
const igFallbackUrl = "https://instagram.com/c.v.accesorios";
---

<article class="product-card opacity-0 translate-y-8 bg-crema rounded-2xl overflow-hidden border border-rosa/40 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 ease-out flex flex-col h-full group">

  <div class="relative aspect-square w-full overflow-hidden bg-rosa/20">
    <img 
      src={imagen} 
      alt={nombre} 
      width="400" 
      height="400" 
      loading="lazy" 
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300 ease-out"
      onerror="this.src='https://via.placeholder.com/400x400/F7D6DF/4A3F44?text=CV+Accesorios'"
    />
  </div>

  <div class="p-5 flex flex-col flex-grow justify-between gap-4">
    <div class="space-y-2">
      <h3 class="font-serif text-lg font-semibold text-texto group-hover:text-rosa-oscuro transition-colors">
        {nombre}
      </h3>
      <p class="text-xs text-texto/75 line-clamp-2 leading-relaxed">
        {descripcion}
      </p>
    </div>

    <div class="pt-2 border-t border-rosa/20 flex items-center justify-between mt-auto">
      <a
        href={igDirectUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-fallback={igFallbackUrl}
        class="btn-consultar-ig inline-flex items-center gap-1.5 text-xs font-medium text-texto bg-rosa/50 hover:bg-rosa-oscuro hover:text-crema px-3.5 py-2 rounded-full transition-colors focus:outline-none"
      >
        <span>Consultar</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  /* Clase activada dinámicamente por IntersectionObserver */
  .product-card.reveal {
    opacity: 1;
    transform: translateY(0);
  }
</style>