---
const currentYear = new Date().getFullYear();

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/monos', label: 'Moños' },
  { href: '/binchas', label: 'Binchas' },
  { href: '/hebillas', label: 'Hebillas' }
];
---

<footer class="bg-rosa/30 border-t border-rosa/40 pt-12 pb-8 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center text-center md:text-left">
      
      <div class="flex flex-col items-center md:items-start gap-2">
        <a href="/" class="flex items-center gap-2 group">
          <img 
            src="/logo.png" 
            alt="CV Accesorios" 
            width="36" 
            height="36" 
            class="w-9 h-9 object-contain rounded-full"
            onerror="this.style.display='none'"
          />
          <span class="font-serif text-xl font-semibold text-texto">CV Accesorios</span>
        </a>
        <p class="text-xs text-texto/70 max-w-xs">
          Accesorios para el pelo hechos a mano con amor y delicadeza en Argentina.
        </p>
      </div>

      <nav class="flex flex-wrap justify-center gap-6">
        {navLinks.map((link) => (
          <a href={link.href} class="text-sm text-texto/80 hover:text-rosa-oscuro transition-colors">
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex flex-col items-center md:items-end gap-4">
        <div class="flex items-center gap-4">
          <a
            href="https://www.instagram.com/c.v.accesorioss"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de CV Accesorios"
            class="p-2 rounded-full bg-crema text-texto hover:text-rosa-oscuro hover:shadow-sm transition-all"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>

          <a
            href="https://wa.me/542494363270"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp de CV Accesorios"
            class="p-2 rounded-full bg-crema text-texto hover:text-rosa-oscuro hover:shadow-sm transition-all"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
          </a>
        </div>

        <button
          id="scroll-to-top"
          type="button"
          class="text-xs text-texto/70 hover:text-rosa-oscuro flex items-center gap-1 transition-colors focus:outline-none"
        >
          <span>Volver arriba</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
          </svg>
        </button>
      </div>

    </div>

    <!-- Copyright -->
    <div class="mt-8 pt-6 border-t border-rosa/20 text-center text-xs text-texto/60">
      <p>© {currentYear} CV Accesorios. Todos los derechos reservados. Hecho a mano con amor.</p>
    </div>
  </div>
</footer>

<script>
  function initFooter() {
    const scrollBtn = document.getElementById('scroll-to-top');
    if (scrollBtn) {
      scrollBtn.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    }
  }

  initFooter();
  document.addEventListener('astro:page-load', initFooter);
</script>