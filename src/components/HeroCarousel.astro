---
import { supabase } from '../lib/supabase';

// Traemos los productos desde Supabase
const { data: productos, error } = await supabase
  .from('productos')
  .select('id, nombre, imagen, categoria');

// Mezclamos la lista de productos de forma aleatoria (Random)
const productosRandom = productos && productos.length > 0 
  ? [...productos].sort(() => 0.5 - Math.random()).slice(0, 8) 
  : [];
---

{productosRandom.length > 0 && (
  <section class="w-full relative overflow-hidden bg-crema/30 py-4 md:py-40">
    <div class="swiper product-hero-swiper w-full">
      <div class="swiper-wrapper">
        {productosRandom.map((producto) => (
          <div class="swiper-slide !w-[280px] sm:!w-[340px] md:!w-[600px] group cursor-pointer">
            <div class="relative aspect-[4/5] sm:aspect-square w-full overflow-hidden border border-rosa/30 shadow-sm bg-rosa/10">
              
              <!-- Imagen del producto con Zoom al Hover -->
              <img 
                src={producto.imagen} 
                alt={producto.nombre}
                loading="lazy"
                class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-110"
                onerror="this.src='https://via.placeholder.com/400x400/F7D6DF/4A3F44?text=CV+Accesorios'"
              />

              <!-- Gradient Overlay para legibilidad del texto -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent pointer-events-none"></div>

              <div class="absolute bottom-0 left-0 p-4 sm:p-5 w-full text-left pointer-events-none">
                <h3 class="font-serif text-base sm:text-2xl font-bold text-crema drop-shadow-md leading-tight line-clamp-1">
                  {producto.nombre}
                </h3>
              </div>

            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- Importamos estilos de Swiper desde CDN de forma liviana -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<script>
  import Swiper from 'swiper';
  import { Autoplay, FreeMode } from 'swiper/modules';

  function initHeroCarousel() {
    const container = document.querySelector('.product-hero-swiper');
    if (!container) return;

    new Swiper('.product-hero-swiper', {
      modules: [Autoplay, FreeMode],
      slidesPerView: 'auto',
      spaceBetween: 16,
      centeredSlides: true,
      loop: true,
      speed: 20000, // Movimiento continuo suave
      autoplay: {
        delay: 0,
        disableOnInteraction: false,
        pauseOnMouseEnter: true, // Se detiene al pasar el mouse/tap
      },
      freeMode: {
        enabled: true,
        sticky: false,
      },
      breakpoints: {
        640: {
          spaceBetween: 24,
          centeredSlides: false,
        }
      }
    });
  }

  // Inicializar en primera carga y al navegar con Astro Transitions
  initHeroCarousel();
  document.addEventListener('astro:page-load', initHeroCarousel);
</script>

<style>
  /* Mantiene la transición fluida y continua sin frenos artificiales */
  .swiper-wrapper {
    transition-timing-function: linear !important;
  }
</style>