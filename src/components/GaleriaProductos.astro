---
// GaleriaProductos.astro
const productos = [
  { 
    id: 1, 
    nombre: 'Moño Velvet', 
    clase: 'md:row-span-2 md:col-span-1', 
    img: '/Captura de pantalla 2026-04-24 092655.png',
    link: '/categorias/moños' 
  },
  { 
    id: 2, 
    nombre: 'Scrunchies', 
    clase: 'md:col-span-2', 
    img: '/Captura de pantalla 2026-04-24 101114.png',
    link: '/categorias/escrunchis'
  },
  { 
    id: 3, 
    nombre: 'Hebilla Perlas', 
    clase: 'md:row-span-1', 
    img: '/Captura de pantalla 2026-04-27 094103.png',
    link: '/categorias/hebillas'
  },
  { 
    id: 4, 
    nombre: 'Colección Otoño', 
    clase: 'md:row-span-2', 
    img: '/Captura de pantalla 2026-04-27 094131.png',
    link: '/categorias/moños' 
  },
  { 
    id: 5, 
    nombre: 'Detalles', 
    clase: 'md:col-span-2', 
    img: '/Captura de pantalla 2026-04-27 094142.png',
    link: '/categorias/bordados'
  },
  { 
    id: 6, 
    nombre: 'Pack Especial', 
    clase: 'md:col-span-3', 
    img: '/Captura de pantalla 2026-04-27 094213.png',
    link: '/categorias/otros'
  },
];
---

<section id="galeria" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4">
    
    <div class="text-center mb-16 reveal">
      <h2 class="font-playfair text-4xl md:text-6xl text-texto-p mb-4 italic">Algunas Creaciones</h2>
      <p class="font-nunito text-texto-s text-xl">Hecho a mano, pensado para vos.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:auto-rows-[300px]">
      {productos.map((prod) => (
        <a 
          href={prod.link} 
          class={`reveal relative group overflow-hidden rounded-3xl shadow-soft block ${prod.clase}`}
        >
          <img 
            src={prod.img} 
            alt={prod.nombre} 
            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
            loading="lazy"
          />
          
          <div class="absolute inset-0 bg-gradient-to-t from-rosa-principal/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500 flex flex-col justify-end p-8">
            <h3 class="font-playfair text-2xl text-white font-bold">{prod.nombre}</h3>
            <p class="text-white/90 font-nunito text-sm uppercase tracking-widest mt-2 flex items-center gap-2">
              Ver categoría 
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-20 text-center reveal">
      <a 
        href="https://www.instagram.com/c.v.accesorioss" 
        target="_blank"
        class="inline-block bg-rosa-principal text-white px-12 py-4 rounded-full font-nunito font-bold text-lg hover:bg-rosa-claro transition-all duration-300 shadow-lg hover:scale-105"
      >
        Seguinos para ver más
      </a>
    </div>
  </div>
</section>